# Root files are opt-in. Stage only the reviewed PUBLISH_FILES.txt allowlist.
/*
!/.gitignore
!/README.md
!/PUBLISH_FILES.txt
!/package.json
!/package-lock.json
!/tsconfig.json
!/config.example.json
!/config.slack.example.json
!/slack-app-manifest.json
!/src/
!/scripts/
!/tests/
!/docs/

# Historical plans and machine-specific operation reports remain local.
/docs/*
!/docs/setup.md
!/docs/discord-setup.md
!/docs/slack-setup.md
!/docs/operations.md
!/docs/publishing.md

# Runtime state, credentials, local configuration and vendor output.
node_modules/
dist/
.data/
.tools/
.local-notes/
.agents/
.codex/
.aws/
.env*
*.local.json
*.local.*
*.sqlite*
*.db
*.db-*
*.log
*.pid
*.lock
*.lock.guard
*.key
*.pem
*.p12
*.pfx
*.keystore
bootstrap-*
*token.local*
recovery/
attachments/
service.log*
service-error.log*
startup-status.json
doctor-report.json
discord-setup.json
aside-registry.json
.DS_Store
*.dmg
*.pkg
*.app/
*.zip
*.tar
*.gz
*.node
*.dylib
*.so
*.exe
*.dll
